// ==========================================
// opencode.jsonc — OpenCode 主配置
// 部署路径: ~/.config/opencode/opencode.jsonc
// 所属包: opencode/
// 功能: AI 编码助手配置（模型路由、MCP 服务器、权限规则）
// 技术要点: 默认模型 Zen Proxy -> deepseek-v4-flash-free
// ==========================================
{
  "$schema": "https://opencode.ai/config.json",
  "model": "zen-proxy/deepseek-v4-flash-free",
  "small_model": "zen-proxy/hy3-free",
  "provider": {
    "cloudflare": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cloudflare Workers AI",
      "models": {
        /* === 常用模型（按需取消注释） === */
        "@cf/qwen/qwen2.5-coder-32b-instruct":         { "name": "Qwen 2.5 Coder 32B" },
        "@cf/qwen/qwq-32b":                             { "name": "QwQ 32B (reasoning)" },
        "@cf/deepseek-ai/deepseek-r1-distill-qwen-32b": { "name": "DeepSeek R1 32B" },
        "@cf/meta/llama-4-scout-17b-16e-instruct":      { "name": "Llama 4 Scout 17B MoE" },

        /* === 备用模型（需要时取消注释） === */
        // "@cf/meta/llama-3.3-70b-instruct-fp8-fast":   { "name": "Llama 3.3 70B" },
        // "@cf/meta/llama-3.1-70b-instruct-fp8-fast":   { "name": "Llama 3.1 70B" },
        // "@cf/meta/llama-3.1-8b-instruct":              { "name": "Llama 3.1 8B" },
        // "@cf/meta/llama-3.1-8b-instruct-fp8-fast":     { "name": "Llama 3.1 8B FP8" },
        // "@cf/meta/llama-3.1-8b-instruct-fp8":          { "name": "Llama 3.1 8B FP8 (slow)" },
        // "@cf/meta/llama-3.1-8b-instruct-awq":          { "name": "Llama 3.1 8B AWQ" },
        // "@cf/meta/llama-3.2-3b-instruct":              { "name": "Llama 3.2 3B" },
        // "@cf/meta/llama-3.2-1b-instruct":              { "name": "Llama 3.2 1B" },
        // "@cf/meta/llama-3-8b-instruct":                { "name": "Llama 3 8B" },
        // "@cf/meta/llama-3-8b-instruct-awq":            { "name": "Llama 3 8B AWQ" },
        // "@cf/meta/llama-2-7b-chat-fp16":               { "name": "Llama 2 7B" },
        // "@cf/meta/llama-3.2-11b-vision-instruct":      { "name": "Llama 3.2 11B Vision" },
        // "@cf/meta/llama-guard-3-8b":                   { "name": "Llama Guard 3 8B" },
        // "@cf/qwen/qwen3-30b-a3b-fp8":                  { "name": "Qwen 3 30B" },
        // "@cf/google/gemma-4-26b-a4b-it":               { "name": "Gemma 4 26B MoE" },
        // "@cf/google/gemma-3-12b-it":                   { "name": "Gemma 3 12B" },
        // "@cf/moonshotai/kimi-k2.7-code":               { "name": "Kimi K2.7 Code" },
        // "@cf/moonshotai/kimi-k2.6":                    { "name": "Kimi K2.6" },
        // "@cf/moonshotai/kimi-k2.5":                    { "name": "Kimi K2.5" },
        // "@cf/mistralai/mistral-small-3.1-24b-instruct": { "name": "Mistral Small 3.1 24B" },
        // "@cf/mistral/mistral-7b-instruct-v0.1":        { "name": "Mistral 7B" },
        // "@cf/nvidia/nemotron-3-120b-a12b":             { "name": "Nemotron 3 120B MoE" },
        // "@cf/openai/gpt-oss-120b":                     { "name": "GPT-OSS 120B" },
        // "@cf/openai/gpt-oss-20b":                      { "name": "GPT-OSS 20B" },
        // "@cf/zai-org/glm-5.2":                         { "name": "GLM 5.2 (coding)" },
        // "@cf/zai-org/glm-4.7-flash":                   { "name": "GLM 4.7 Flash" },
        // "@cf/ibm-granite/granite-4.0-h-micro":         { "name": "Granite 4.0 Micro" },
        // "@cf/aisingapore/gemma-sea-lion-v4-27b-it":    { "name": "Gemma Sea Lion 27B" }
      },
      "options": {
        "baseURL": "https://api.cloudflare.com/client/v4/accounts/9da0c9ee3ffbc50e0a4d5cb11e03b1d8/ai/v1",
        "apiKey": "{env:CLOUDFLARE_AI_TOKEN}"
      }
    },
    "agnes": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Agnes AI (free)",
      "models": {
        "agnes-2.0-flash":                               { "name": "Agnes 2.0 Flash" },
        "agnes-1.5-flash":                               { "name": "Agnes 1.5 Flash" }
      },
      "options": {
        "baseURL": "https://apihub.agnes-ai.com/v1",
        "apiKey": "{env:AGNES_API_KEY}"
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek Official API",
      "models": {
        "deepseek-v4-pro":  { "name": "DeepSeek V4 Pro" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" }
      },
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    },
    "zen-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zen (auto-failover)",
      "options": {
        "baseURL": "http://127.0.0.1:8123/v1"
      },
      "models": {
        "deepseek-v4-flash-free":  { "name": "DeepSeek V4 Flash Free" },
        "north-mini-code-free":    { "name": "North Mini Code Free" },
        "nemotron-3-ultra-free":   { "name": "Nemotron 3 Ultra Free" },
        "mimo-v2.5-free":         { "name": "MiMo V2.5 Free" },
        "hy3-free":               { "name": "HY3 Free" }
      }
    },
    "cloud-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cloud AI (openapi.cloud-ai.cn)",
      "options": {
        "baseURL": "https://openapi.cloud-ai.cn/v1",
        "apiKey": "{env:CLOUD_AI_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash":         { "name": "DeepSeek V4 Flash" },
        "deepseek-v4-pro":           { "name": "DeepSeek V4 Pro" },
        "glm-5.2":                   { "name": "GLM-5.2" },
        "glm-5.1":                   { "name": "GLM-5.1" },
        "glm-5":                     { "name": "GLM-5" },
        "kimi-k2.5":                 { "name": "Kimi K2.5" },
        "kimi-k2.6":                 { "name": "Kimi K2.6" },
        "qwen-3.7-plus-test":        { "name": "Qwen 3.7 Plus" },
        "hy3":                       { "name": "Hy3" },
        "minimax-m2.5":              { "name": "MiniMax M2.5" },
        "doubao-seed-2.1-pro-test":  { "name": "Doubao Seed 2.1 Pro" }
      }
    },
    "foxcode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fox Code (code.newcli.com)",
      "options": {
        "baseURL": "https://code.newcli.com/codex/v1",
        "apiKey": "{env:FOX_API_KEY}"
      },
      "models": {
        "gpt-5.5":     { "name": "GPT 5.5" },
        "gpt-5.6-sol":  { "name": "GPT 5.6 Sol" },
        "gpt-5.6-terra": { "name": "GPT 5.6 Terra" },
        "gpt-5.4":      { "name": "GPT 5.4" }
      }
    },
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go (opencode.ai/zen/go)",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash":  { "name": "DeepSeek V4 Flash" },
        "deepseek-v4-pro":    { "name": "DeepSeek V4 Pro" },
        "glm-5.2":            { "name": "GLM-5.2" },
        "glm-5.1":            { "name": "GLM-5.1" },
        "glm-5":              { "name": "GLM-5" },
        "kimi-k2.7-code":     { "name": "Kimi K2.7 Code" },
        "kimi-k2.6":          { "name": "Kimi K2.6" },
        "kimi-k2.5":          { "name": "Kimi K2.5" },
        "qwen3.7-plus":       { "name": "Qwen 3.7 Plus" },
        "qwen3.7-max":        { "name": "Qwen 3.7 Max" },
        "qwen3.6-plus":       { "name": "Qwen 3.6 Plus" },
        "mimo-v2.5-pro":      { "name": "MiMo V2.5 Pro" },
        "mimo-v2.5":          { "name": "MiMo V2.5" },
        "mimo-v2-pro":        { "name": "MiMo V2 Pro" },
        "minimax-m3":         { "name": "MiniMax M3" },
        "minimax-m2.7":       { "name": "MiniMax M2.7" },
        "minimax-m2.5":       { "name": "MiniMax M2.5" },
        "hy3-preview":        { "name": "Hy3 Preview" }
      }
    },
    "asl": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ASL (api.aslnet.cloud)",
      "options": {
        "baseURL": "https://api.aslnet.cloud/v1",
        "apiKey": "{env:ASL_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol":       { "name": "GPT 5.6 Sol" },
        "gpt-5.5":           { "name": "GPT 5.5" },
        "gpt-5.6-terra":     { "name": "GPT 5.6 Terra" },
        "gpt-5.6-luna":      { "name": "GPT 5.6 Luna" },
        "gpt-5.4":           { "name": "GPT 5.4" },
        "gpt-5.4-mini":      { "name": "GPT 5.4 Mini" },
        "gpt-5.2":           { "name": "GPT 5.2" },
        "codex-mini-latest":  { "name": "Codex Mini" }
      }
    }
  },
  "formatter": false,
  "lsp": false,
  "snapshot": true,
  "autoupdate": "notify",
  "plugin": ["oh-my-openagent", "@oh-my-kiro/oh-my-kiro"],
  "instructions": ["AGENTS.md"],
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "permission": {
    "bash": {
      "rm -rf *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny",
      "> /dev/sda *": "deny",
      ":(){ :|:& };: *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "*": "ask"
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/Users/zhuyao/dotfiles"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "postgresql://ai:***@localhost:5432/ai"],
      "enabled": false
    }
  }
}
