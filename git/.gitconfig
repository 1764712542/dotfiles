# ==========================================
# .gitconfig — Git 全局配置
# 部署路径: ~/.gitconfig
# 所属包: git/
# 功能: 用户信息、别名、delta diff 分页器、SSH 代替 HTTPS
# 注意事项: 全局 gitignore 在 .gitignore_global
# ==========================================

[user]
	name = ryanzhu
	email = 1764712542@qq.com

[core]
	excludesfile = ~/.gitignore_global
	pager = delta

[init]
	defaultBranch = main

[pull]
	rebase = true

[diff]
	algorithm = histogram

[merge]
	conflictstyle = zdiff3

[fetch]
	prune = true
	pruneTags = true

[push]
	autoSetupRemote = true
	followTags = true

[rebase]
	autosquash = true

[log]
	decorate = auto

[interactive]
	diffFilter = delta --color-only

[delta]
	side-by-side = true
	navigate = true
	line-numbers = true
	syntax-theme = TokyoNight

[alias]
	st = status -sb
	co = checkout
	cob = checkout -b
	br = branch
	ci = commit
	cm = commit -m
	ca = commit -a
	cam = commit -am
	amend = commit --amend --no-edit
	df = diff
	dc = diff --cached
	lg = log --oneline --graph --decorate --all -20
	lga = log --oneline --graph --decorate --all
	rh = reset HEAD~
	rb = rebase
	rbc = rebase --continue
	rba = rebase --abort
	rbi = rebase -i
	cp = cherry-pick
	ss = stash save
	sl = stash list
	sp = stash pop
	sh = show
	sw = switch
	ssw = switch -
	mg = merge --no-ff
[url "git@github.com:"]
	insteadOf = https://github.com/
[safe]
	directory = /Users/zhuyao
	directory = *
[http]
	version = HTTP/1.1
